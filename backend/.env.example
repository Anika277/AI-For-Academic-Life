PORT=5000

# Your actual Groq API key (get it from console.groq.com)
OPENAI_API_KEY=your_actual_groq_api_key_here

# If your code still expects XAI_API_KEY, set it to the same for now
XAI_API_KEY=your_actual_groq_api_key_here

# ⚠️ IMPORTANT: "grok-4-fast" is an xAI model, NOT a Groq model.
# Groq models are like: "llama-3.3-70b-versatile", "mixtral-8x7b-32768", "gemma2-9b-it"
# Change this to a valid Groq model name if you intend to use Groq.
GROK_MODEL=openai/gpt-oss-120b